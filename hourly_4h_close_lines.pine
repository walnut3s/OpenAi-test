//@version=6
indicator("Multi-TF Anchor Lines", overlay=true, max_lines_count=500)

anchorInput = input.string("Close", "Anchor point", options=["Close", "High", "Low"], tooltip="Anchor lines to the close, high, or low of each completed period.")

grp = "Timeframes"
show5m  = input.bool(false, "5 min",  group=grp, inline="5")
col5m   = input.color(color.gray,   "", group=grp, inline="5")
show15m = input.bool(false, "15 min", group=grp, inline="15")
col15m  = input.color(color.teal,   "", group=grp, inline="15")
show1h  = input.bool(true,  "1 hour", group=grp, inline="60")
col1h   = input.color(color.blue,   "", group=grp, inline="60")
show4h  = input.bool(true,  "4 hour", group=grp, inline="240")
col4h   = input.color(color.red,    "", group=grp, inline="240")
showD   = input.bool(false, "Daily",  group=grp, inline="D")
colD    = input.color(color.orange, "", group=grp, inline="D")
showW   = input.bool(false, "Weekly", group=grp, inline="W")
colW    = input.color(color.purple, "", group=grp, inline="W")

// Anchor value of the last completed bar on the given timeframe. [1] with
// lookahead_on is the standard non-repainting way to read a finished HTF bar.
anchorSrc = anchorInput == "High" ? high : anchorInput == "Low" ? low : close
htf(tf) =>
    request.security(syminfo.tickerid, tf, anchorSrc[1], lookahead=barmerge.lookahead_on)

v5m  = htf("5")
v15m = htf("15")
v1h  = htf("60")
v4h  = htf("240")
vD   = htf("D")
vW   = htf("W")

new5m  = timeframe.change("5")
new15m = timeframe.change("15")
new1h  = timeframe.change("60")
new4h  = timeframe.change("240")
newD   = timeframe.change("D")
newW   = timeframe.change("W")

// Draws the anchor line for one timeframe. A new line starts at each period
// boundary and extends along the current bar.
drawTf(show, isNew, v, col, wid) =>
    var line ln = na
    ln := show and isNew and not na(v) ? line.new(time[1], v, time, v, xloc=xloc.bar_time, color=col, width=wid) : ln
    if show and not na(ln)
        line.set_x2(ln, time)

drawTf(show5m,  new5m,  v5m,  col5m,  1)
drawTf(show15m, new15m, v15m, col15m, 1)
drawTf(show1h,  new1h,  v1h,  col1h,  1)
drawTf(show4h,  new4h,  v4h,  col4h,  2)
drawTf(showD,   newD,   vD,   colD,   2)
drawTf(showW,   newW,   vW,   colW,   3)
